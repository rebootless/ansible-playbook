services:
  filebrowser:
    image: "filebrowser/filebrowser:{{ filebrowser_image_version }}"
    restart: unless-stopped
    command:
      - -d
      - /database/filebrowser.db
      # File Browser has no way to detect that nginx is reverse-proxying it
      # under /filebrowser/ (roles/nginx/templates/partials/filebrowser-proxy.conf.j2).
      # Without --baseurl, File Browser generates all its internal links/API
      # calls as if it owns the site root, so behind a /filebrowser/ prefix
      # the UI loads a blank page and spins forever. --baseurl tells it "you
      # are actually mounted at /filebrowser/", so it must match the nginx
      # location exactly (including no trailing slash here). Also: nginx
      # must pass this prefix through unstripped (proxy_pass with no URI) —
      # if nginx strips it, File Browser's own /filebrowser-prefixed routes
      # never match anything and every request 404s from File Browser itself
      # rather than from nginx.
      - --baseurl
      - /filebrowser
    volumes:
      - ./srv:/srv
      - ./database:/database
    ports:
      - "127.0.0.1:8080:80"
    healthcheck:
      test: ["CMD-SHELL", "wget -qO- http://localhost/health || exit 1"]
      interval: 10s
      timeout: 5s
      retries: 6
      start_period: 10s
